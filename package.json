{
  "name": "pdflexi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/copy-pdf-assets.mjs && tsc -b && vite build && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs && node tests/execution.e2e.mjs",
    "typecheck": "tsc -b",
    "package:preview": "node scripts/standalone.mjs",
    "format": "prettier --write src packages tests scripts docs *.md *.json *.ts *.mjs .github",
    "format:check": "prettier --check src packages tests scripts docs *.md *.json *.ts *.mjs .github",
    "postinstall": "node scripts/copy-pdf-assets.mjs",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "lint": "eslint src packages tests scripts vite.config.ts",
    "tools:sync": "node scripts/sync-tools.mjs && prettier --write packages/tools/src/{index,loaders,translations}.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.51.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ]
}
